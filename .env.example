# Required API keys (set whichever backends you use)
OPENROUTER_API_KEY=
IMG_AI_API_KEY=          # Google Gemini / Veo / TTS / dubbing (also accepted as GOOGLE_API_KEY)
XAI_API_KEY=             # Grok text + animation
ELEVEN_API_KEY=          # ElevenLabs TTS / SFX

# Optional model overrides
#AI_TEXT_MODEL=gemini-2.5-pro
#AI_IMAGE_MODEL=google/gemini-3-pro-image-preview
#AI_GEMINI_MODEL=gemini-2.5-flash

# Optional runtime tuning
#AI_CONCURRENCY=10
#AI_IMAGE_CONCURRENCY=5
#AI_SEED=42
#AI_LOG_LEVEL=INFO
#AI_ASPECT_RATIO=9:16
#AI_IMAGE_SIZE=2K
#AI_REF_ASPECT_RATIO=9:16
#AI_VIDEO_TIMEOUT=600
#TARGET_LANGUAGE=English
