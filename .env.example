# Required API keys (set whichever backends you use)
OPENROUTER_API_KEY=
IMG_AI_API_KEY=          # Google Gemini / Veo / TTS / dubbing (also accepted as GOOGLE_API_KEY)
XAI_API_KEY=             # Grok animation (animation grok)
ELEVEN_API_KEY=          # ElevenLabs TTS / SFX

# Optional model overrides (defaults shown)
#AI_TEXT_MODEL=google/gemini-4-hydrogen
#AI_QA_MODEL=google/gemini-3.8-flash   # cheaper QA/continuity judge (default: AI_TEXT_MODEL)
#AI_IMAGE_MODEL=google/gemini-nano-banana-2.1
#AI_GEMINI_MODEL=google/gemini-3.8-flash

# Optional runtime tuning
#AI_CONCURRENCY=10
#AI_IMAGE_CONCURRENCY=5
#AI_SEED=42
#AI_LOG_LEVEL=INFO
#AI_ASPECT_RATIO=9:16
#AI_IMAGE_SIZE=2K
#AI_REF_ASPECT_RATIO=9:16
#AI_VIDEO_TIMEOUT=600
#TARGET_LANGUAGE=English
